# Copy to .env and fill in. Never commit the real .env file.

# X (Twitter) API v2 app-only Bearer Token
# Developer Portal -> Projects & Apps -> your app -> Keys and tokens
X_BEARER_TOKEN=PASTE_YOUR_BEARER_TOKEN_HERE

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tweetsdb

# Flask
FLASK_DEBUG=1
PORT=5000
